# Configuração do Banco de Dados PostgreSQL (ou SQLite para desenvolvimento local)
# Exemplo PostgreSQL: postgresql://robocode:robocode_secret_pass@localhost:5432/robocode_db
# Exemplo SQLite (padrão se não informado): sqlite:///./robocode.db

DATABASE_URL=postgresql://robocode:robocode_secret_pass@localhost:5432/robocode_db
SECRET_KEY=super_secret_jwt_key_robocode_2026_gamified
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
